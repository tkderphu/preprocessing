# ──────────────────────────────────────────────────────────────────
# Document Intelligence Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
DEBUG=false
UPLOAD_DIR=app/storage/uploads

# ── RabbitMQ / Celery ────────────────────────────────────────────
# Override these in docker-compose (already set via environment:)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_QUEUE_NAME=document_jobs

# ── Whisper / Audio ──────────────────────────────────────────────
# Sizes: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
# Device: cpu | cuda
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# HuggingFace token (required for speaker diarization with pyannote.audio)
# Get yours at: https://huggingface.co/settings/tokens
# Accept the model license at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=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

# ── Apache Tika ───────────────────────────────────────────────
TIKA_URL=http://tika:9998

# ── Groq ─────────────────────────────────────────────────────────
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# ── Email (Gmail SMTP example) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Use an App Password (not your main password):
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
# Default recipient (can be overridden per-upload)
MAIL_TO=recipient@example.com

# ── GitHub ───────────────────────────────────────────────────────
# PAT with repo scope: https://github.com/settings/tokens
GITHUB_TOKEN=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 
# Format: owner/repo-name
GITHUB_REPO=tkderphu/docs
GITHUB_BRANCH=main
GITHUB_OUTPUT_PATH=docs